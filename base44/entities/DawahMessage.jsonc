{
  "name": "DawahMessage",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "reminder",
        "dawah",
        "encouragement",
        "dua"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "subject": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0636\u0648\u0639"
    },
    "content": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062d\u062a\u0648\u0649"
    },
    "verse_reference": {
      "type": "string",
      "description": "\u0645\u0631\u062c\u0639 \u0622\u064a\u0629 \u0642\u0631\u0622\u0646\u064a\u0629"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0642\u0631\u0648\u0621\u0629"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 (\u0641\u0644\u062a\u0631\u0629)"
    }
  },
  "required": [
    "recipient_email",
    "content"
  ]
}