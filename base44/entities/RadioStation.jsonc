{
  "name": "RadioStation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062d\u0637\u0629"
    },
    "stream_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0628\u062b \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "station_type": {
      "type": "string",
      "enum": [
        "live_makkah",
        "live_madinah",
        "general",
        "quran_only"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062d\u0637\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u062d\u0637\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0645\u062d\u0637\u0629 \u0646\u0634\u0637\u0629"
    },
    "is_live": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0628\u062b \u0645\u0628\u0627\u0634\u0631"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0644\u062f"
    },
    "listeners_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u0645\u0639\u064a\u0646 \u0627\u0644\u062d\u0627\u0644\u064a\u064a\u0646"
    },
    "favorite_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0641\u0636\u0644\u0627\u062a"
    },
    "audio_quality": {
      "type": "string",
      "enum": [
        "128kbps",
        "192kbps",
        "320kbps",
        "lossless"
      ],
      "default": "192kbps",
      "description": "\u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u062a"
    }
  },
  "required": [
    "name",
    "stream_url",
    "station_type"
  ]
}