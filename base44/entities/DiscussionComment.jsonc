{
  "name": "DiscussionComment",
  "type": "object",
  "properties": {
    "discussion_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0646\u0642\u0627\u0634"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0623\u0628 (\u0644\u0644\u0631\u062f\u0648\u062f)"
    },
    "content": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062a\u0639\u0644\u064a\u0642"
    },
    "author_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0643\u0627\u062a\u0628"
    },
    "author_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u062a\u0628"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0625\u0639\u062c\u0627\u0628\u0627\u062a"
    },
    "is_edited": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "is_approved": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629"
    }
  },
  "required": [
    "discussion_id",
    "content",
    "author_id"
  ]
}