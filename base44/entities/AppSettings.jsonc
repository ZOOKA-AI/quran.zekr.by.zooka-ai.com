{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ],
      "default": "auto",
      "description": "\u0627\u0644\u0633\u0645\u0629"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "fr",
        "ur"
      ],
      "default": "ar",
      "description": "\u0627\u0644\u0644\u063a\u0629"
    },
    "font_type": {
      "type": "string",
      "enum": [
        "uthmani",
        "indopak",
        "simple"
      ],
      "default": "uthmani",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062e\u0637"
    },
    "font_size": {
      "type": "number",
      "default": 18,
      "description": "\u062d\u062c\u0645 \u0627\u0644\u062e\u0637"
    },
    "translation_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0631\u062c\u0645\u0629"
    },
    "translation_language": {
      "type": "string",
      "default": "english",
      "description": "\u0644\u063a\u0629 \u0627\u0644\u062a\u0631\u062c\u0645\u0629"
    },
    "tafsir_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0641\u0633\u064a\u0631"
    },
    "audio_autoplay": {
      "type": "boolean",
      "default": false,
      "description": "\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a"
    },
    "default_reciter": {
      "type": "string",
      "default": "ar.alafasy",
      "description": "\u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a"
    },
    "prayer_times_city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0644\u0645\u0648\u0627\u0642\u064a\u062a \u0627\u0644\u0635\u0644\u0627\u0629"
    }
  },
  "required": []
}