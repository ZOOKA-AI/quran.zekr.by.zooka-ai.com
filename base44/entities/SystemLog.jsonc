{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "cache_update",
        "api_sync",
        "user_action",
        "error",
        "optimization",
        "performance"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062d\u062f\u062b"
    },
    "entity_type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0643\u064a\u0627\u0646 \u0627\u0644\u0645\u062a\u0623\u062b\u0631"
    },
    "entity_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0643\u064a\u0627\u0646"
    },
    "action": {
      "type": "string",
      "description": "\u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u062a\u062e\u0630"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "pending"
      ],
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "details": {
      "type": "object",
      "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "duration_ms": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0628\u0627\u0644\u0645\u064a\u0644\u064a \u062b\u0627\u0646\u064a\u0629"
    },
    "error_message": {
      "type": "string",
      "description": "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062e\u0637\u0623 \u0625\u0646 \u0648\u062c\u062f\u062a"
    },
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u062a\u0623\u062b\u0631"
    },
    "metadata": {
      "type": "object",
      "description": "\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0639\u0631\u064a\u0641\u064a\u0629 \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u062d\u062f\u062b"
    }
  },
  "required": [
    "event_type",
    "action",
    "status"
  ]
}