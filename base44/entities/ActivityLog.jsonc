{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "surah_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "listen",
        "read",
        "bookmark",
        "share",
        "discuss"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0646\u0634\u0627\u0637"
    },
    "duration_seconds": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u0646\u0634\u0627\u0637 \u0628\u0627\u0644\u062b\u0648\u0627\u0646\u064a"
    },
    "points_earned": {
      "type": "number",
      "description": "\u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0645\u0643\u062a\u0633\u0628\u0629"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0643\u062a\u0645\u0644\u062a \u0627\u0644\u0633\u0648\u0631\u0629 \u0643\u0627\u0645\u0644\u0629"
    },
    "completed_verses": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0622\u064a\u0627\u062a \u0627\u0644\u0645\u0642\u0631\u0648\u0621\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0646\u0634\u0627\u0637"
    }
  },
  "required": [
    "user_email",
    "surah_number",
    "activity_type",
    "duration_seconds"
  ]
}