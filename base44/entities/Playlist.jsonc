{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0642\u0627\u0626\u0645\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0642\u0627\u0626\u0645\u0629"
    },
    "cover_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u0627\u0644\u063a\u0644\u0627\u0641"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0639\u0627\u0645\u0629 \u0623\u0645 \u062e\u0627\u0635\u0629"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recitation_id": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        }
      },
      "description": "\u0627\u0644\u062a\u0644\u0627\u0648\u0627\u062a \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629"
    },
    "total_duration": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629"
    },
    "total_plays": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644"
    },
    "total_followers": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u064a\u0646"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0648\u0633\u0648\u0645"
    },
    "playlist_type": {
      "type": "string",
      "enum": [
        "user",
        "featured",
        "auto_generated",
        "recommended"
      ],
      "default": "user",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0642\u0627\u0626\u0645\u0629"
    }
  },
  "required": [
    "title"
  ]
}