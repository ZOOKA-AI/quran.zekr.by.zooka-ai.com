{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ],
      "default": "auto",
      "description": "\u0627\u0644\u0645\u0638\u0647\u0631"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "default": "ar",
      "description": "\u0627\u0644\u0644\u063a\u0629"
    },
    "font_size": {
      "type": "number",
      "default": 16,
      "description": "\u062d\u062c\u0645 \u0627\u0644\u062e\u0637 (1-5)"
    },
    "font_style": {
      "type": "string",
      "enum": [
        "uthmani",
        "indopak",
        "simplified"
      ],
      "default": "uthmani",
      "description": "\u0646\u0645\u0637 \u0627\u0644\u062e\u0637"
    },
    "default_reciter": {
      "type": "string",
      "description": "\u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a"
    },
    "audio_quality": {
      "type": "string",
      "enum": [
        "128kbps",
        "192kbps",
        "320kbps"
      ],
      "default": "192kbps",
      "description": "\u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u062a"
    },
    "auto_play": {
      "type": "boolean",
      "default": false,
      "description": "\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a"
    },
    "show_translation": {
      "type": "boolean",
      "default": true,
      "description": "\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0631\u062c\u0645\u0629"
    },
    "translation_language": {
      "type": "string",
      "default": "en",
      "description": "\u0644\u063a\u0629 \u0627\u0644\u062a\u0631\u062c\u0645\u0629"
    },
    "show_tafsir": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0641\u0633\u064a\u0631"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a"
    },
    "daily_reminder_time": {
      "type": "string",
      "description": "\u0648\u0642\u062a \u0627\u0644\u062a\u0630\u0643\u064a\u0631 \u0627\u0644\u064a\u0648\u0645\u064a (HH:MM)"
    },
    "keyboard_shortcuts": {
      "type": "object",
      "properties": {
        "play_pause": {
          "type": "string",
          "default": "Space"
        },
        "next_surah": {
          "type": "string",
          "default": "ArrowRight"
        },
        "prev_surah": {
          "type": "string",
          "default": "ArrowLeft"
        },
        "volume_up": {
          "type": "string",
          "default": "ArrowUp"
        },
        "volume_down": {
          "type": "string",
          "default": "ArrowDown"
        }
      },
      "description": "\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d"
    },
    "privacy_settings": {
      "type": "object",
      "properties": {
        "share_listening_stats": {
          "type": "boolean",
          "default": false
        },
        "share_bookmarks": {
          "type": "boolean",
          "default": false
        },
        "allow_recommendations": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629"
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "high_contrast": {
          "type": "boolean",
          "default": false
        },
        "text_spacing": {
          "type": "number",
          "default": 1
        },
        "screen_reader_enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0648\u0635\u0648\u0644"
    },
    "api_cache_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0645\u0624\u0642\u062a\u0627\u064b"
    },
    "auto_update_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0645\u0632\u0627\u0645\u0646\u0629"
    }
  },
  "required": [
    "user_id"
  ]
}