{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "theme": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string",
          "default": "#059669"
        },
        "font_family": {
          "type": "string",
          "enum": [
            "Amiri",
            "Noto Naskh Arabic",
            "Cairo",
            "Scheherazade"
          ],
          "default": "Amiri"
        },
        "font_size": {
          "type": "number",
          "default": 24
        },
        "dark_mode": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0638\u0647\u0631"
    },
    "audio": {
      "type": "object",
      "properties": {
        "playback_speed": {
          "type": "number",
          "default": 1.0
        },
        "auto_play_next": {
          "type": "boolean",
          "default": false
        },
        "repeat_mode": {
          "type": "string",
          "enum": [
            "none",
            "verse",
            "surah"
          ],
          "default": "none"
        }
      },
      "description": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0635\u0648\u062a"
    },
    "display": {
      "type": "object",
      "properties": {
        "verse_layout": {
          "type": "string",
          "enum": [
            "standard",
            "mushaf",
            "list"
          ],
          "default": "standard"
        },
        "show_translation": {
          "type": "boolean",
          "default": true
        },
        "show_transliteration": {
          "type": "boolean",
          "default": false
        },
        "show_tafsir": {
          "type": "boolean",
          "default": false
        },
        "translation_language": {
          "type": "string",
          "enum": [
            "english",
            "french",
            "urdu",
            "indonesian",
            "turkish"
          ],
          "default": "english"
        }
      },
      "description": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0631\u0636"
    },
    "reminders": {
      "type": "object",
      "properties": {
        "prayer_reminders": {
          "type": "boolean",
          "default": true
        },
        "quran_reading_reminder": {
          "type": "boolean",
          "default": true
        },
        "morning_athkar": {
          "type": "boolean",
          "default": true
        },
        "evening_athkar": {
          "type": "boolean",
          "default": true
        },
        "reminder_time": {
          "type": "string",
          "default": "09:00"
        }
      },
      "description": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0630\u0643\u064a\u0631\u0627\u062a"
    }
  },
  "required": []
}