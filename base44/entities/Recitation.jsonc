{
  "name": "Recitation",
  "type": "object",
  "properties": {
    "reciter_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0642\u0631\u0626"
    },
    "surah_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629"
    },
    "audio_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0635\u0648\u062a"
    },
    "cdn_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 CDN \u0625\u0646 \u0648\u062c\u062f"
    },
    "source_url": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0623\u0635\u0644\u064a \u0644\u0644\u062a\u0644\u0627\u0648\u0629"
    },
    "attribution": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "\u0627\u0639\u062a\u0645\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0635\u062f\u0631 \u0648\u0627\u0644\u062a\u0631\u062e\u064a\u0635"
    },
    "duration": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u062f\u0629 \u0628\u0627\u0644\u062b\u0648\u0627\u0646\u064a"
    },
    "file_size": {
      "type": "number",
      "description": "\u062d\u062c\u0645 \u0627\u0644\u0645\u0644\u0641 \u0628\u0627\u0644\u0645\u064a\u062c\u0627\u0628\u0627\u064a\u062a"
    },
    "bitrate": {
      "type": "string",
      "enum": [
        "128kbps",
        "192kbps",
        "320kbps",
        "lossless"
      ],
      "default": "192kbps",
      "description": "\u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u062a"
    },
    "total_plays": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644"
    },
    "total_likes": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0625\u0639\u062c\u0627\u0628\u0627\u062a"
    },
    "total_shares": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0627\u062a"
    },
    "recording_year": {
      "type": "number",
      "description": "\u0633\u0646\u0629 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "recording_location": {
      "type": "string",
      "description": "\u0645\u0643\u0627\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u062a\u0644\u0627\u0648\u0629 \u0645\u062a\u0627\u062d\u0629"
    }
  },
  "required": [
    "reciter_id",
    "surah_number",
    "audio_url"
  ]
}