{
  "name": "PlaybackPosition",
  "type": "object",
  "properties": {
    "reciter_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0631\u0626"
    },
    "surah_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629"
    },
    "verse_start": {
      "type": "number",
      "description": "\u0627\u0644\u0622\u064a\u0629 \u0645\u0646"
    },
    "verse_end": {
      "type": "number",
      "description": "\u0627\u0644\u0622\u064a\u0629 \u0625\u0644\u0649"
    },
    "current_time": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u062d\u0627\u0644\u064a \u0628\u0627\u0644\u062b\u0648\u0627\u0646\u064a"
    },
    "duration": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0643\u0644\u064a\u0629"
    },
    "last_played": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0648\u0642\u062a \u062a\u0634\u063a\u064a\u0644"
    }
  },
  "required": [
    "reciter_name",
    "surah_number"
  ]
}