{
  "name": "ReadingGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "cover_image": {
      "type": "string",
      "description": "\u0635\u0648\u0631\u0629 \u063a\u0644\u0627\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "admin_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0645\u0634\u0631\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "joined_date": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "moderator",
              "member"
            ],
            "default": "member"
          }
        }
      },
      "description": "\u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "reading_plan": {
      "type": "object",
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "custom"
          ]
        },
        "surahs": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "\u062e\u0637\u0629 \u0627\u0644\u0642\u0631\u0627\u0621\u0629"
    },
    "members_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0623\u0639\u0636\u0627\u0621"
    },
    "discussions_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0646\u0642\u0627\u0634\u0627\u062a"
    },
    "completion_rate": {
      "type": "number",
      "default": 0,
      "description": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0625\u0646\u062c\u0627\u0632"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0646\u0634\u0637\u0629"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    }
  },
  "required": [
    "name",
    "admin_id"
  ]
}