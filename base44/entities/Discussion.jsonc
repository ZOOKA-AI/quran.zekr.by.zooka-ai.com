{
  "name": "Discussion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0646\u0642\u0627\u0634"
    },
    "content": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0646\u0642\u0627\u0634"
    },
    "discussion_type": {
      "type": "string",
      "enum": [
        "verse",
        "hadith",
        "dua",
        "general"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0646\u0642\u0627\u0634"
    },
    "reference": {
      "type": "object",
      "properties": {
        "surah_number": {
          "type": "number"
        },
        "verse_number": {
          "type": "number"
        },
        "verse_text": {
          "type": "string"
        }
      },
      "description": "\u0645\u0631\u062c\u0639 \u0627\u0644\u0622\u064a\u0629 \u0623\u0648 \u0627\u0644\u062f\u0639\u0627\u0621"
    },
    "group_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "author_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0643\u0627\u062a\u0628"
    },
    "author_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u062a\u0628"
    },
    "comments_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0625\u0639\u062c\u0627\u0628\u0627\u062a"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u062b\u0628\u062a"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u0642\u0641\u0644"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0646\u0642\u0627\u0634"
    }
  },
  "required": [
    "title",
    "content",
    "discussion_type",
    "author_id"
  ]
}