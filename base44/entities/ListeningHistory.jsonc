{
  "name": "ListeningHistory",
  "type": "object",
  "properties": {
    "recitation_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062a\u0644\u0627\u0648\u0629"
    },
    "reciter_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0642\u0631\u0626"
    },
    "surah_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629"
    },
    "play_duration": {
      "type": "number",
      "description": "\u0645\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639 \u0628\u0627\u0644\u062b\u0648\u0627\u0646\u064a"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0633\u062a\u0645\u0639 \u0644\u0644\u0646\u0647\u0627\u064a\u0629"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "web",
        "mobile",
        "tablet",
        "desktop"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062c\u0647\u0627\u0632"
    },
    "listening_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639"
    }
  },
  "required": [
    "recitation_id",
    "reciter_id",
    "surah_number"
  ]
}