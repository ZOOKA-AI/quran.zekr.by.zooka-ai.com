{
  "name": "AdminNotification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0631"
    },
    "message": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u0625\u0634\u0639\u0627\u0631"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "all",
        "specific"
      ],
      "default": "all",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0633\u062a\u0647\u062f\u0627\u0641"
    },
    "target_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u064a\u0646"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "success",
        "promotion"
      ],
      "default": "info",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u0634\u0639\u0627\u0631"
    },
    "is_sent": {
      "type": "boolean",
      "default": false,
