  "whatsapp_greeting": "\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0643\u0645 \u0648\u0631\u062d\u0645\u0629 \u0627\u0644\u0644\u0647 \u0648\u0628\u0631\u0643\u0627\u062a\u0647 \ud83c\udf19\n\n\u0623\u0647\u0644\u0627\u064b \u0628\u0643! \u0623\u0646\u0627 **Zekr AI** \u2014 \u0645\u0633\u0627\u0639\u062f \u0642\u0631\u0622\u0646\u064a \u0648\u0645\u0639\u0631\u0641\u064a \u0625\u0633\u0644\u0627\u0645\u064a \u0645\u0648\u062b\u0651\u0642 \ud83d\udcd6\u2728\n\n\u064a\u0645\u0643\u0646\u0646\u064a \u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0641\u064a:\n\n\ud83d\udcd6 **\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0622\u064a\u0627\u062a** \u2014 \u0645\u0646 \u0645\u0635\u0627\u062f\u0631 \u0645\u0648\u062b\u0642\u0629 \u0645\u0639 \u0646\u0633\u0628\u0629 \u0627\u0644\u0623\u0642\u0648\u0627\u0644\n\ud83d\udd0d **\u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0642\u0631\u0622\u0646** \u2014 \u0627\u0628\u062d\u062b \u0639\u0646 \u0623\u064a \u0622\u064a\u0629 \u0623\u0648 \u0645\u0648\u0636\u0648\u0639\n\ud83d\udca1 **\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0646\u0632\u0648\u0644 \u0648\u0639\u0644\u0648\u0645 \u0627\u0644\u0642\u0631\u0622\u0646**\n\ud83d\udcff **\u0627\u0644\u0623\u0630\u0643\u0627\u0631 \u0648\u0627\u0644\u0623\u062f\u0639\u064a\u0629 \u0627\u0644\u0645\u0623\u062b\u0648\u0631\u0629**\n\u2696\ufe0f **\u0627\u0644\u0645\u0639\u0627\u0631\u0643 \u0627\u0644\u0641\u0642\u0647\u064a\u0629** \u2014 \u0639\u0631\u0636 \u0627\u0644\u0623\u0642\u0648\u0627\u0644 \u0648\u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u062f\u0648\u0646 \u0627\u062e\u062a\u0644\u0627\u0642\n\ud83c\udf93 **\u0627\u0644\u062d\u0641\u0638 \u0648\u0627\u0644\u062a\u062c\u0648\u064a\u062f**\n\n\ud83d\udccc \u0642\u0627\u0639\u062f\u062a\u064a: **\u0627\u0644\u0645\u0635\u062f\u0631 \u0623\u0648\u0644\u064b\u0627**. \u0644\u0627 \u0623\u062e\u062a\u0644\u0642 \u0622\u064a\u0629\u064b \u0648\u0644\u0627 \u062d\u062f\u064a\u062b\u064b\u0627 \u0648\u0644\u0627 \u0641\u062a\u0648\u0649\u060c \u0648\u0643\u0644 \u0625\u062c\u0627\u0628\u0629 \u0639\u0644\u0645\u064a\u0629 \u062a\u0639\u0631\u0636 \u0645\u0635\u0627\u062f\u0631\u0647\u0627.\n\n\u26a0\ufe0f \u0644\u0644\u0641\u062a\u0648\u0649 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u064a\u064f\u0631\u062c\u0639 \u0625\u0644\u0649 \u062c\u0647\u0629 \u0625\u0641\u062a\u0627\u0621 \u0645\u062e\u062a\u0635\u0629.\n\n\ud83d\udcac \u0627\u0643\u062a\u0628 \u0633\u0624\u0627\u0644\u0643 \u0648\u0633\u0623\u062c\u064a\u0628\u0643 \u0645\u0646 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u062a\u0627\u062d\u0629.\n\n\ufd3f \u0648\u064e\u0646\u064f\u0646\u064e\u0632\u0650\u0651\u0644\u064f \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0622\u0646\u0650 \u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0634\u0650\u0641\u064e\u0627\u0621\u064c \u0648\u064e\u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064c \u0644\u0650\u0651\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \ufd3e"
}